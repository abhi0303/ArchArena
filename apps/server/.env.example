# Copy to apps/server/.env and adjust.

# PostgreSQL connection string. `docker compose up -d` at the repo root starts a matching database.
DATABASE_URL="postgresql://archarena:archarena@localhost:5432/archarena?schema=public"

# Port the API listens on. The Vite dev server proxies /api to it.
PORT=4000

# Public origin of the web app. Used for CORS-style origin checks on state-changing requests.
# Comma-separate multiple origins.
APP_ORIGIN="http://localhost:5173"

# Session lifetime in days.
SESSION_TTL_DAYS=30

# Set to true when running behind a TLS-terminating proxy (enables Secure cookies and trust proxy).
BEHIND_PROXY=false

# Optional: enables "Sign in with Google". Create an OAuth client ID (Web) in Google Cloud Console.
# Leave empty to hide the Google button (email/password sign-in always works).
GOOGLE_CLIENT_ID=""

# Optional: directory with the built web app (apps/web/dist). When set, the API also serves the SPA.
WEB_DIST_DIR=""
